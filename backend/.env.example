# --- Interface access (REQUIRED, never commit real values) ---
# Password required to use the dashboard
APP_PASSWORD=
# Random string (>=16 chars) used to sign session tokens: openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_SEC=28800

# --- Server ---
PORT=4000
# Comma-separated list of allowed frontend origins (CORS). GitHub Pages origin has no path:
# https://<user>.github.io
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
ACTION_RATE_LIMIT_PER_MIN=30

# --- Persistence / secrets ---
DB_PATH=./data/bot.db
# Key used to encrypt MT5 credentials at rest (AES-256-GCM). If empty, a key file is generated.
SECRET_KEY=
SECRET_KEY_FILE=./data/secret.key

# --- Worker ---
# Run the sync/rules worker inside the API process (required for the "mock" provider, whose state is in-memory)
EMBED_WORKER=true
POLL_INTERVAL_MS=5000

# --- MT5 ---
# Mock provider only: simulate price movements on each poll
MOCK_MARKET=true
MT5_TIMEOUT_MS=8000
MT5_RETRIES=2
# Only for provider "bridge": HTTP bridge running next to the MT5 terminal
MT5_BRIDGE_URL=
MT5_BRIDGE_TOKEN=
